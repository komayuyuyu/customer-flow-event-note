rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isOptionalShortString(data, field, maxLength) {
      return !(field in data) || isShortString(data[field], maxLength);
    }

    function isOptionalList(data, field, maxItems) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxItems);
    }

    function isValidTime(value) {
      return value is string
        && value.matches('^$|^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isAllowedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == '__ALLOWED_UID__';
    }

    function hasValidObservationSchema(recordDate) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'date',
          'eventIds',
          'relatedEvents',
          'weather',
          'trafficLevel',
          'quietPeriods',
          'actualImpactStart',
          'actualImpactEnd',
          'accuracy',
          'eventImpact',
          'note',
          'customerTopics',
          'calendarContext',
          'ownerUid',
          'updatedAt',
        ])
        && data.keys().hasAll(['date', 'ownerUid', 'trafficLevel', 'updatedAt'])
        && data.ownerUid == request.auth.uid
        && data.date is string
        && data.date == recordDate
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.trafficLevel in ['暇', '通常', '混雑']
        && (!(('weather') in data) || data.weather in ['晴れ', '曇り', '雨', '雪', '荒天', '不明'])
        && (!(('accuracy') in data) || data.accuracy in ['予測どおり', '一部当たった', '外れた', '未判断'])
        && (!(('eventImpact') in data) || data.eventImpact in ['感じた', '感じなかった', 'わからない', '対象外'])
        && (!(('actualImpactStart') in data) || isValidTime(data.actualImpactStart))
        && (!(('actualImpactEnd') in data) || isValidTime(data.actualImpactEnd))
        && isOptionalShortString(data, 'note', 600)
        && isOptionalShortString(data, 'customerTopics', 600)
        && (!('note' in data) || !('customerTopics' in data)
          || data.note.size() + data.customerTopics.size() <= 600)
        && isOptionalList(data, 'eventIds', 64)
        && isOptionalList(data, 'relatedEvents', 64)
        && isOptionalList(data, 'quietPeriods', 5)
        && (!('quietPeriods' in data)
          || data.quietPeriods.toSet().hasOnly(['午前', '昼', '夕方', '終日', '特になし']))
        && isOptionalList(data, 'calendarContext', 16)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId}/observations/{recordDate} {
      allow read: if isAllowedOwner(userId);
      allow create, update: if isAllowedOwner(userId)
        && hasValidObservationSchema(recordDate);
      allow delete: if isAllowedOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
